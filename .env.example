# Local application
MORI_ENV=development
API_ORIGIN=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
VITE_API_ORIGIN=http://localhost:8000
# VITE_USE_MOCK_API=true

# Local PostgreSQL
POSTGRES_DB=mori
POSTGRES_USER=mori
POSTGRES_PASSWORD=mori_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mori:mori_local_only@localhost:5432/mori

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SIGNING_KEY=
OAUTH_STATE_KEY=

# Optional identity policy overrides
# AUTH_SESSION_TTL_SECONDS=2592000
# OAUTH_ATTEMPT_TTL_SECONDS=600
# AUTH_RETURN_PATHS=["/"]

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_EXTRACTOR_MODEL=
OPENAI_SAFETY_ID_SECRET=
